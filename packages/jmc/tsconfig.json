{
    "compilerOptions": {
        "target": "ESNext",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "inlineSources": true,
        "outDir": "dist",
        "rootDir": "src",
        "moduleResolution": "bundler" // without this, react types cannot resolve import * as CSS from "csstype";
    },
    "include": [
        "src"
    ],
    "exclude": [
        "dist"
    ]
}