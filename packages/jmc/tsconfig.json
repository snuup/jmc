{
  "compilerOptions": {
    "target": "ESNEXT",
    "module": "ESNext",

    "jsx": "react",
    "jsxFactory": "jsx",
    "jsxFragmentFactory": "jsxf",

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,
    "inlineSources": true,

    "outDir": "dist",
    "rootDir": "src",

    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "moduleResolution": "bundler",

    "esModuleInterop": true,

    "experimentalDecorators": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "preserveConstEnums": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}