{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "rootDir": "..",
        "noEmit": true,
        "skipLibCheck": true, // happy-dom's types need @types/node
        "jsx": "react",
        "jsxFactory": "jsx",
        "jsxFragmentFactory": "jsxf"
    },
    "include": ["."],
    "exclude": ["automatic"] // has its own tsconfig, for the automatic JSX runtime
}
