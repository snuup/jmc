{
    "compilerOptions": {
        "strict": true, // although true shall be the default, without this weird type errors occur
        "target": "ESNext",
        "declaration": true,
        // "declarationMap": true,
        // "sourceMap": true,
        // "inlineSources": true,
        //"outDir": "dist",
