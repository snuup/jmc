{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "rootDir": "../..",
        "jsx": "react-jsx",
        "jsxImportSource": "@snupo/jmc",
        "jsxFactory": null,
        "jsxFragmentFactory": null,
        "paths": {
            "@snupo/jmc": ["../../src/index.ts"],
            "@snupo/jmc/jsx-runtime": ["../../src/jsx-runtime.ts"],
            "@snupo/jmc/jsx-dev-runtime": ["../../src/jsx-dev-runtime.ts"]
        }
    },
    "include": [".", "../globals.d.ts"],
    "exclude": []
}
