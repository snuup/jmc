{
    "name": "@snupo/jmc",
    "author": "snupo",
    "version": "1.0.50",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc -p tsconfig.json",
        "release": "release-it patch"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.10",
        "happy-dom": "^16.8.1",
        "release-it": "^21.0.2",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "vitest": "4.1.10"
    },
    "release-it": {
        "hooks": {
            "before:init": [
                "pnpm vitest"
            ],
            "after:bump": "pnpm build"
        },
        "git": {
            "commitMessage": "chore: release v${version}"
        },
        "github": {
            "release": true
        }
    }
}
