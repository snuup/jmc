{
    "name": "@snupo/jmc",
    "description": "Minimal JSX/TSX view library that syncs directly with the real DOM",
    "keywords": ["jsx", "tsx", "dom", "view", "ui", "typescript"],
    "author": "snupo",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/snuup/jmc.git"
    },
    "homepage": "https://github.com/snuup/jmc#readme",
    "bugs": "https://github.com/snuup/jmc/issues",
    "version": "1.0.61",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./jsx-runtime": {
            "types": "./dist/jsx-runtime.d.ts",
            "import": "./dist/jsx-runtime.js"
        },
        "./jsx-dev-runtime": {
            "types": "./dist/jsx-dev-runtime.d.ts",
            "import": "./dist/jsx-dev-runtime.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "release": "release-it patch"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "4.1.10",
        "happy-dom": "^16.8.1",
        "release-it": "^21.0.2",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "vitest": "4.1.10"
    },
    "release-it": {
        "hooks": {
            "before:init": [
                "pnpm vitest run"
            ],
            "after:bump": "pnpm build"
        },
        "git": {
            "commitMessage": "chore: release v${version}"
        },
        "github": {
            "release": true
        }
    }
}
